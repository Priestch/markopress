/**
 * Documentation layout with sidebar and table of contents
 */

<const/title=input.frontmatter?.title || 'Documentation'/>
<const/description=input.frontmatter?.description || ''/>
<const/headers=input.headers || []/>
<const/editUrl=input.editUrl/>
<const/lastUpdated=input.lastUpdated/>
<const/prevPage=input.prevPage/>
<const/nextPage=input.nextPage/>

<!DOCTYPE html>
<html lang="en">
<head>
  <theme-head-top/>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>${title}</title>
  <if=description>
    <meta name="description" content=description>
  </if>
  <theme-head-bottom/>
</head>
<body>
  <theme-body-top/>

  <!-- Skip to main content (accessibility) -->
  <skip-link/>

  <!-- Reading Progress Indicator -->
  <reading-progress/>

  <div class="docs-layout">
    <!-- Header/Navbar -->
    <header class="navbar">
      <theme-navbar-start siteTitle=input.siteTitle logo=input.logo url=input.base||"/"/>
      <theme-navbar-center/>
      <theme-navbar-end/>
    </header>

    <div class="docs-container">
      <aside class="sidebar">
        <theme-sidebar-top/>
        <sidebar sections=input.sidebar/>
        <theme-sidebar-bottom/>
      </aside>
      <main id="main-content" class="docs-content">
        <theme-doc-top/>
        <article class="docs-article main-content">
          <h1>${title}</h1>
          <${input.renderBody()} />
        </article>

        <!-- Documentation Footer -->
        <doc-footer
          editUrl=editUrl
          lastUpdated=lastUpdated
          prev=prevPage
          next=nextPage/>

        <theme-doc-bottom/>
      </main>
      <aside class="toc">
        <theme-aside-top/>
        <toc headers=headers/>
        <theme-aside-bottom/>
      </aside>
    </div>
    <footer/>
  </div>

  <theme-body-bottom/>
</body>
</html>
