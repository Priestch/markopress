/**
 * Documentation layout with sidebar and table of contents
 */

class {
  onCreate() {
    this.state = {
      title: input.frontmatter?.title || 'Documentation',
      description: input.frontmatter?.description || '',
      headers: input.headers || [],
      editUrl: input.editUrl,
      lastUpdated: input.lastUpdated,
      prevPage: input.prevPage,
      nextPage: input.nextPage,
    };
  }
}

<!DOCTYPE html>
<html lang="en">
<head>
  <theme-head-top/>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>${state.title}</title>
  <if=state.description>
    <meta name="description" content="${state.description}">
  </if>
  <theme-head-bottom/>
</head>
<body>
  <theme-body-top/>

  <!-- Skip to main content (accessibility) -->
  <skip-link/>

  <!-- Reading Progress Indicator -->
  <reading-progress/>

  <div class="docs-layout">
    <!-- Header/Navbar -->
    <header class="navbar">
      <theme-navbar-start siteTitle=input.siteTitle logo=input.logo url=input.base||"/"/>
      <theme-navbar-center/>
      <theme-navbar-end/>
    </header>

    <div class="docs-container">
      <aside class="sidebar">
        <theme-sidebar-top/>
        <sidebar sections=input.sidebar/>
        <theme-sidebar-bottom/>
      </aside>
      <main id="main-content" class="docs-content">
        <theme-doc-top/>
        <article class="docs-article main-content">
          <h1>${state.title}</h1>
          <${input.renderBody()} />
        </article>

        <!-- Documentation Footer -->
        <doc-footer
          editUrl=state.editUrl
          lastUpdated=state.lastUpdated
          prev=state.prevPage
          next=state.nextPage/>

        <theme-doc-bottom/>
      </main>
      <aside class="toc">
        <theme-aside-top/>
        <toc headers=state.headers/>
        <theme-aside-bottom/>
      </aside>
    </div>
    <footer/>
  </div>

  <theme-body-bottom/>
</body>
</html>
