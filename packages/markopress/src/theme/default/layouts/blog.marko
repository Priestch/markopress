/**
 * Blog listing layout
 */

<const/title=input.frontmatter?.title || 'Blog'/>
<const/posts=input.posts || []/>

<!DOCTYPE html>
<html lang="en">
<head>
  <theme-head-top/>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>${title}</title>
  <theme-head-bottom/>
</head>
<body>
  <theme-body-top/>

  <div class="blog-layout">
    <!-- Header/Navbar -->
    <header class="navbar">
      <theme-navbar-start siteTitle=input.siteTitle logo=input.logo url=input.base||"/"/>
      <theme-navbar-center/>
      <theme-navbar-end/>
    </header>

    <main class="blog-content">
      <theme-page-top/>
      <h1>${title}</h1>
      <div class="posts-list">
        <for|post| of=posts>
          <article class="post-summary">
            <h2>
              <a href="${post.urlPath}">${post.frontmatter.title}</a>
            </h2>
            <p class="post-meta">
              <if=post.frontmatter.date>
                <span>${post.frontmatter.date}</span>
              </if>
              <if=post.frontmatter.author>
                <span> by ${post.frontmatter.author}</span>
              </if>
            </p>
            <if=post.processed.excerpt>
              <p class="post-excerpt">${post.processed.excerpt}</p>
            </if>
          </article>
        </for>
      </div>
      <theme-page-bottom/>
    </main>

    <footer/>
  </div>

  <theme-body-bottom/>
</body>
</html>
