/**
 * Default page layout
 */

<const/title=input.frontmatter?.title || 'Page'/>
<const/description=input.frontmatter?.description || ''/>

<!DOCTYPE html>
<html lang="en">
<head>
  <theme-head-top/>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>${title}</title>
  <if=description>
    <meta name="description" content=description>
  </if>
  <theme-head-bottom/>
</head>
<body>
  <theme-body-top/>

  <div class="page">
    <!-- Header/Navbar -->
    <header class="navbar">
      <theme-navbar-start siteTitle=input.siteTitle logo=input.logo url=input.base||"/"/>
      <theme-navbar-center/>
      <theme-navbar-end/>
    </header>

    <main class="content">
      <theme-page-top/>
      <article>
        <h1>${title}</h1>
        <${input.renderBody()} />
      </article>
      <theme-page-bottom/>
    </main>

    <footer/>
  </div>

  <theme-body-bottom/>
</body>
</html>
