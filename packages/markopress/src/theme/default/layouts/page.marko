/**
 * Default page layout
 */

class {
  onCreate() {
    this.state = {
      title: input.frontmatter?.title || 'Page',
      description: input.frontmatter?.description || '',
    };
  }
}

<!DOCTYPE html>
<html lang="en">
<head>
  <theme-head-top/>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>${state.title}</title>
  <if=state.description>
    <meta name="description" content="${state.description}">
  </if>
  <theme-head-bottom/>
</head>
<body>
  <theme-body-top/>

  <div class="page">
    <!-- Header/Navbar -->
    <header class="navbar">
      <theme-navbar-start siteTitle=input.siteTitle logo=input.logo url=input.base||"/"/>
      <theme-navbar-center/>
      <theme-navbar-end/>
    </header>

    <main class="content">
      <theme-page-top/>
      <article>
        <h1>${state.title}</h1>
        <${input.renderBody()} />
      </article>
      <theme-page-bottom/>
    </main>

    <footer/>
  </div>

  <theme-body-bottom/>
</body>
</html>
