/*!
 * Default Layout for MarkoPress
 * Main layout wrapper with theme support, navigation, and SEO
 */

<let/darkMode=false/>
<let/mobileMenuOpen=false/>
<let/sidebarOpen=true/>
<const/basePath=($global.base === '/' ? '' : $global.base) || ''/>

<lifecycle
  onMount() {
    // Check for saved theme preference or system preference
    const savedTheme = localStorage.getItem('theme');
    const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;

    if (savedTheme === 'dark' || (!savedTheme && prefersDark)) {
      darkMode = true;
      document.documentElement.classList.add('dark');
    }

    // Check for saved sidebar state
    const sidebarState = localStorage.getItem('sidebar');
    if (sidebarState === 'closed') {
      sidebarOpen = false;
    }
  }
/>

<!DOCTYPE html>
<html lang=input.lang||"en">
<head>
  <theme-head-top/>

  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="icon" type="image/svg+xml" href=input.favicon||"/logo.svg">

  <!-- Dynamic Title with Template -->
  <title>${input.title ? `${input.title} | ${input.siteTitle || 'MarkoPress'}` : input.siteTitle || 'MarkoPress'}</title>

  <!-- Meta Description -->
  <if=input.description>
    <meta name="description" content=input.description>
  </if>

  <!-- Open Graph / Facebook -->
  <meta property="og:type" content="website">
  <meta property="og:title" content=input.title||input.siteTitle||'MarkoPress'>
  <meta property="og:description" content=input.description||'A modern static site generator'>
  <if=input.ogImage>
    <meta property="og:image" content=input.ogImage>
  </if>
  <if=input.url>
    <meta property="og:url" content=input.url>
  </if>

  <!-- Twitter -->
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content=input.title||input.siteTitle||'MarkoPress'>
  <meta name="twitter:description" content=input.description||'A modern static site generator'>
  <if=input.twitterImage>
    <meta name="twitter:image" content=input.twitterImage>
  </if>

  <!-- Canonical URL -->
  <if=input.canonical>
    <link rel="canonical" href=input.canonical>
  </if>

  <!-- Additional Head Tags -->
  <for(input.head||[])>
    <include(...)/>
  </for>

  <!-- Theme Styles -->
  <style>
    <include('../styles.css')/>
  </style>

  <!-- Component Styles -->
  <link rel="stylesheet" href=(basePath + '/markopress-components.css')>

  <theme-head-bottom/>
</head>
<body class=${[
  'theme-default',
  darkMode ? 'dark' : 'light',
  !sidebarOpen ? 'sidebar-closed' : ''
].filter(Boolean).join(' ')}>
  <theme-body-top/>

  <!-- Skip to content link (accessibility) -->
  <a href="#content" class="skip-to-content">Skip to main content</a>

  <!-- Background Pattern -->
  <div class="background-pattern"></div>

  <div class="app-container">
    <!-- Header/Navbar -->
    <header class="navbar">
      <div class="navbar-container">
        <!-- Logo and Site Title -->
        <theme-navbar-start siteTitle=input.siteTitle logo=input.logo url=input.base||"/"/>

        <!-- Desktop Navigation -->
        <theme-navbar-center/>

        <!-- Header Actions -->
        <theme-navbar-end darkMode=darkMode mobileMenuOpen=mobileMenuOpen />
      </div>

      <!-- Mobile Menu -->
      <if=mobileMenuOpen>
        <div class="navbar-mobile-menu">
          <nav-bar/>
        </div>
      </if>
    </header>

    <div class="layout-container">
      <!-- Sidebar (if provided) -->
      <aside class="sidebar" class-list={collapsed: !sidebarOpen}>
        <div class="sidebar-container">
          <!-- Collapse Button -->
          <button class="sidebar-toggle-btn" onClick() {
            sidebarOpen = !sidebarOpen;
            localStorage.setItem('sidebar', sidebarOpen ? 'open' : 'closed');
          } aria-label="Toggle sidebar">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <polyline points="15 18 9 12 15 6"></polyline>
            </svg>
          </button>

          <!-- Sidebar Content -->
          <theme-sidebar-top/>
          <sidebar/>
          <theme-sidebar-bottom/>
        </div>
      </aside>

      <!-- Main Content Area -->
      <main class="main-content" id="content">
        <theme-page-top/>
        <theme-doc-top/>

        <!-- Page Content -->
        <${input.content}/>

        <!-- Prev/Next Navigation (if provided) -->
        <if=(input.prev || input.next)>
          <div class="page-nav">
            <if=input.prev>
              <a class="page-nav-prev" href=input.prev.url>
                <span class="page-nav-label">← Previous</span>
                <span class="page-nav-title">${input.prev.title}</span>
              </a>
            </if>
            <if=input.next>
              <a class="page-nav-next" href=input.next.url>
                <span class="page-nav-label">Next →</span>
                <span class="page-nav-title">${input.next.title}</span>
              </a>
            </if>
          </div>
        </if>

        <theme-doc-bottom/>
        <theme-page-bottom/>
      </main>

      <!-- Table of Contents -->
      <aside class="toc-aside">
        <div class="toc-container">
          <theme-aside-top/>
          <h2 class="toc-title">On This Page</h2>
          <toc/>
          <theme-aside-bottom/>
        </div>
      </aside>
    </div>

    <!-- Footer -->
    <footer class="footer">
      <footer/>
    </footer>
  </div>

  <!-- Client Scripts -->
  <script src="/theme.js"></script>

  <theme-body-bottom/>
</body>
</html>
