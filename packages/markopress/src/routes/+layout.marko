<!DOCTYPE html>
<html lang=$global.lang||"en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>${$global.title || 'MarkoPress Site'}</title>
  <if=$global.description>
    <meta name="description" content=$global.description>
  </if>
  <link rel="stylesheet" href="/theme.css">
</head>
<body>
  <div class="app-container">
    <!-- Navbar -->
    <nav class="navbar">
      <div class="navbar-container">
        <a href="/" class="navbar-brand">
          <span class="navbar-title">MarkoPress Site</span>
        </a>

        <!-- Desktop Nav -->
        <if=$global.navbar>
          <nav class="navbar-nav desktop-only">
            <for|item| of=$global.navbar>
              <a href=item.link class="nav-link">${item.text}</a>
            </for>
          </nav>
        </if>

        <!-- Header Actions -->
        <div class="navbar-actions">
          <!-- Dark Mode Toggle -->
          <button class="btn-icon" aria-label="Toggle dark mode" on-click=toggleDarkMode>
            <span ref="sun-icon" class="icon-sun">☀️</span>
            <span ref="moon-icon" class="icon-moon">🌙</span>
          </button>

          <!-- Mobile Menu Toggle -->
          <button class="btn-icon mobile-menu-toggle" aria-label="Toggle menu" on-click=toggleMobileMenu>
            <span ref="menu-icon" class="icon-menu">☰</span>
            <span ref="close-icon" class="icon-close">✕</span>
          </button>
        </div>
      </div>

      <!-- Mobile Menu -->
      <if=$global.navbar>
        <nav ref="mobile-sidebar" class="navbar-mobile-menu">
          <for|item| of=$global.navbar>
            <a href=item.link class="nav-link">${item.text}</a>
          </for>
        </nav>
      </if>
    </nav>

    <!-- Main content area with optional sidebar -->
    <div class="main-wrapper">
      <if=$global.sidebar>
        <!-- Sidebar for docs -->
        <aside class="sidebar desktop-only">
          <nav class="sidebar-nav">
            <for|item| of=$global.sidebar>
              <a href=item.link class="sidebar-link">${item.text}</a>
            </for>
          </nav>
        </aside>
      </if>

      <!-- Page content -->
      <main class="main-content">
        <${input.content}/>
      </main>
    </div>

    <!-- Footer -->
    <footer class="footer">
      <div class="footer-container">
        <p>&copy; 2024 MarkoPress Site. Built with MarkoPress.</p>
      </div>
    </footer>
  </div>

  <script>
    class Layout {
      state = {
        darkMode: false,
        mobileMenuOpen: false,
      };

      onMount() {
        // Check for saved theme preference
        const savedTheme = localStorage.getItem('theme');
        if (savedTheme === 'dark') {
          this.state.darkMode = true;
          document.documentElement.classList.add('dark');
        }

        // Check system preference
        if (!savedTheme && window.matchMedia('(prefers-color-scheme: dark)').matches) {
          this.state.darkMode = true;
          document.documentElement.classList.add('dark');
        }

        this.updateUI();
      }

      toggleDarkMode() {
        this.state.darkMode = !this.state.darkMode;
        document.documentElement.classList.toggle('dark', this.state.darkMode);
        localStorage.setItem('theme', this.state.darkMode ? 'dark' : 'light');
        this.updateUI();
      }

      toggleMobileMenu() {
        this.state.mobileMenuOpen = !this.state.mobileMenuOpen;
        this.updateUI();
      }

      updateUI() {
        // Update dark mode icons
        const sunIcon = this.getEl('sun-icon');
        const moonIcon = this.getEl('moon-icon');
        if (sunIcon && moonIcon) {
          sunIcon.style.display = this.state.darkMode ? 'inline' : 'none';
          moonIcon.style.display = this.state.darkMode ? 'none' : 'inline';
        }

        // Update mobile menu icons
        const menuIcon = this.getEl('menu-icon');
        const closeIcon = this.getEl('close-icon');
        if (menuIcon && closeIcon) {
          menuIcon.style.display = this.state.mobileMenuOpen ? 'none' : 'inline';
          closeIcon.style.display = this.state.mobileMenuOpen ? 'inline' : 'none';
        }

        // Update mobile menu visibility
        const sidebar = this.getEl('mobile-sidebar');
        if (sidebar) {
          sidebar.style.display = this.state.mobileMenuOpen ? 'block' : 'none';
        }
      }
    }
  </script>

  <style>
    .icon-sun, .icon-moon, .icon-menu, .icon-close {
      font-size: 1.2rem;
      line-height: 1;
    }

    .icon-moon, .icon-close {
      display: none;
    }

    .dark .icon-sun {
      display: inline;
    }

    .dark .icon-moon {
      display: none;
    }

    .desktop-only {
      display: block;
    }

    .navbar-mobile-menu {
      display: none;
    }

    @media (max-width: 768px) {
      .desktop-only {
        display: none;
      }
    }

    .btn-icon {
      background: none;
      border: none;
      cursor: pointer;
      padding: 0.5rem;
      display: inline-flex;
      align-items: center;
      justify-content: center;
    }

    .navbar-mobile-menu {
      display: none;
      padding: 1rem;
      border-top: 1px solid var(--border-default, #e5e7eb);
    }

    .navbar-mobile-menu .nav-link {
      display: block;
      padding: 0.5rem 0;
      color: inherit;
      text-decoration: none;
    }
  </style>
</body>
</html>
