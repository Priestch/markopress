{
  "name": "markopress",
  "version": "0.1.0",
  "description": "A general-purpose static site generator using Marko.js v6",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "markopress": "./bin/cli.js"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./config": {
      "import": "./dist/config/index.js",
      "types": "./dist/config/index.d.ts"
    },
    "./markdown": {
      "import": "./dist/markdown/index.js",
      "types": "./dist/markdown/index.d.ts"
    },
    "./content": {
      "import": "./dist/content/index.js",
      "types": "./dist/content/index.d.ts"
    },
    "./plugin": {
      "import": "./dist/plugin/index.js",
      "types": "./dist/plugin/index.d.ts"
    },
    "./theme": {
      "import": "./dist/theme/index.js",
      "types": "./dist/theme/index.d.ts"
    },
    "./vite": {
      "import": "./dist/vite/index.js",
      "types": "./dist/vite/index.d.ts"
    }
  },
  "scripts": {
    "build": "pnpm exec tsc --outDir dist --rootDir src --module Node16 --target ESNext --moduleResolution node16 --esModuleInterop --skipLibCheck --strict --declaration --declarationMap --sourceMap src/**/*.ts",
    "dev": "pnpm exec tsc --outDir dist --rootDir src --module Node16 --target ESNext --moduleResolution node16 --esModuleInterop --skipLibCheck --strict --declaration --declarationMap --sourceMap src/**/*.ts --watch",
    "typecheck": "pnpm exec tsc --noEmit src/**/*.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui"
  },
  "dependencies": {
    "chokidar": "^3.5.3",
    "commander": "^12.0.0",
    "fast-glob": "^3.3.0",
    "gray-matter": "^4.0.3",
    "markdown-it": "^14.0.0",
    "markdown-it-anchor": "^8.6.7",
    "markdown-it-attrs": "^4.1.6",
    "markdown-it-container": "^4.0.0",
    "markdown-it-emoji": "^3.0.0",
    "p-limit": "^4.0.0",
    "shiki": "^1.0.0",
    "zod": "^4.3.5"
  },
  "peerDependencies": {
    "@marko/run": "^0.9.0",
    "marko": "^6.0.0",
    "vite": "^7.0.0"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    }
  },
  "devDependencies": {
    "@marko/run": "^0.9.4",
    "@types/markdown-it": "^14.0.0",
    "@types/node": "^20.10.0",
    "@vitest/ui": "^4.0.17",
    "typescript": "^5.3.0",
    "vite": "^7.3.1",
    "vitest": "^4.0.17"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "files": [
    "dist",
    "bin",
    "templates"
  ]
}
