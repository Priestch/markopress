{
  "name": "markopress",
  "version": "0.0.4",
  "description": "A fast, modern static site generator built on Marko.js v6 - drop-in alternative to VitePress and Docusaurus with full content compatibility",
  "keywords": [
    "static-site-generator",
    "ssg",
    "marko",
    "markojs",
    "marko.js",
    "vitepress-alternative",
    "docusaurus-alternative",
    "documentation",
    "docs",
    "blog",
    "markdown",
    "developer-tools",
    "web-development"
  ],
  "homepage": "https://priestch.github.io/markopress/",
  "bugs": {
    "url": "https://github.com/Priestch/markopress/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Priestch/markopress.git",
    "directory": "packages/markopress"
  },
  "author": "MarkoPress Team",
  "license": "MIT",
  "type": "module",
  "marko": {
    "src": "src/theme/default"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "markopress": "./bin/cli.js"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./config": {
      "import": "./dist/config/index.js",
      "types": "./dist/config/index.d.ts"
    },
    "./markdown": {
      "import": "./dist/markdown/index.js",
      "types": "./dist/markdown/index.d.ts"
    },
    "./content": {
      "import": "./dist/content/index.js",
      "types": "./dist/content/index.d.ts"
    },
    "./plugin": {
      "import": "./dist/plugin/index.js",
      "types": "./dist/plugin/index.d.ts"
    },
    "./theme": {
      "import": "./dist/theme/index.js",
      "types": "./dist/theme/index.d.ts"
    },
    "./build": {
      "import": "./dist/build/vite-markdown-plugin.js"
    },
    "./vite": {
      "import": "./dist/vite/index.js",
      "types": "./dist/vite/index.d.ts"
    },
    "./plugins/*": {
      "import": "./dist/plugins/*.js",
      "types": "./dist/plugins/*.d.ts"
    },
    "./marko.json": "./marko.json",
    "./src/theme/default/tags/*": "./src/theme/default/tags/*"
  },
  "scripts": {
    "build": "pnpm exec tsc && node scripts/minify.js",
    "dev": "pnpm exec tsc --watch",
    "typecheck": "pnpm exec tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "release": "node scripts/release.js"
  },
  "dependencies": {
    "chokidar": "^3.5.3",
    "commander": "^12.0.0",
    "fast-glob": "^3.3.0",
    "gray-matter": "^4.0.3",
    "markdown-it": "^14.0.0",
    "markdown-it-anchor": "^8.6.7",
    "markdown-it-attrs": "^4.1.6",
    "markdown-it-container": "^4.0.0",
    "markdown-it-emoji": "^3.0.0",
    "minisearch": "^7.2.0",
    "p-limit": "^4.0.0",
    "shiki": "^1.0.0",
    "zod": "^4.3.5"
  },
  "peerDependencies": {
    "@marko/run": "^0.9.0",
    "marko": "^6.0.0",
    "vite": "^7.0.0"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    }
  },
  "devDependencies": {
    "@marko/run": "^0.9.4",
    "@types/markdown-it": "^14.0.0",
    "@types/node": "^20.10.0",
    "@vitest/ui": "^4.0.17",
    "execa": "^9.6.1",
    "picocolors": "^1.1.1",
    "prompts": "^2.4.2",
    "semver": "^7.7.4",
    "terser": "^5.31.0",
    "typescript": "^5.3.0",
    "vite": "^7.3.1",
    "vitest": "^4.0.17"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "files": [
    "marko.json",
    "dist",
    "bin",
    "templates",
    "src/theme/default"
  ]
}
