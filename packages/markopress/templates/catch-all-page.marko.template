<div class="content {{CONTENT_TYPE_CLASS}}">
  <theme-body-top/>
  <div class="content-layout">
    <div class="content-body">
      <h1>${$global.title}</h1>
      <if=$global.description>
        <p class="description">${$global.description}</p>
      </if>
      <if=$global.date>
        <p class="meta">Published: ${$global.date}</p>
      </if>
      <if=$global.author>
        <p class="meta">By ${$global.author}</p>
      </if>
      <if=$global.tags>
        <p class="meta">
          <for|tag| of=$global.tags>
            <span class="tag">${tag}</span>
          </for>
        </p>
      </if>
      <hr>
      <${$global.contentComponent || {}}>
        <div>No content</div>
      </${$global.contentComponent || {}}>
      <if=$global.registry?.blog?.length>
        <section class="recent-posts">
          <h2>Recent Posts</h2>
          <ul>
            <for|post| of=$global.registry.blog>
              <if=post.metadata.date>
                <li>
                  <a href=post.urlPath>${post.metadata.title || post.urlPath}</a>
                  <small>${new Date(post.metadata.date).toLocaleDateString()}</small>
                </li>
              </if>
            </for>
          </ul>
        </section>
      </if>
    </div>
    <if=$global.toc>
      <toc headers=$global.toc/>
    </if>
  </div>
  <theme-body-bottom/>
</div>

<style>
  .content-layout {
    display: flex;
    gap: 32px;
    max-width: 1100px;
    margin: 0 auto;
    position: relative;
  }

  .content-body {
    flex: 1;
    min-width: 0;
    max-width: 100%;
  }

  .toc {
    position: sticky;
    top: 1rem;
    width: 200px;
    flex-shrink: 0;
  }

  .meta {
    font-size: 0.875rem;
    color: #666;
  }

  .tag {
    display: inline-block;
    background: #e5e7eb;
    padding: 0.125rem 0.5rem;
    border-radius: 4px;
    margin-right: 0.5rem;
    font-size: 0.75rem;
  }

  .recent-posts {
    margin-top: 2rem;
    padding-top: 1.5rem;
    border-top: 1px solid #e5e7eb;
  }

  .recent-posts h2 {
    margin-bottom: 0.75rem;
  }

  .recent-posts ul {
    list-style: none;
    padding: 0;
  }

  .recent-posts li {
    padding: 0.5rem 0;
    display: flex;
    justify-content: space-between;
    align-items: baseline;
  }

  .recent-posts li a {
    color: var(--color-primary-2, #3b82f6);
    text-decoration: none;
  }

  .recent-posts li a:hover {
    text-decoration: underline;
  }

  .recent-posts small {
    color: #6b7280;
    font-size: 0.8rem;
  }
</style>
