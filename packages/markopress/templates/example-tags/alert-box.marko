<!-- Alert Box Component -->
<!-- Types: note, tip, warning, danger, info, caution -->
<!-- Example: <alert-box kind="warning">This is important!</alert-box> -->

<div class=["alert", input.kind && "alert-" + input.kind, !input.kind && "alert-note"]>
  <div class="alert-content">
    <${input.content}/>
  </div>
</div>

<style>
  .alert {
    --alert-icon-size: 1.5rem;
  }

  .alert-content {
    position: relative;
    z-index: 1;
  }

  /* Ensure markdown content renders properly */
  .alert-content p:first-child {
    margin-top: 0;
  }

  .alert-content p:last-child {
    margin-bottom: 0;
  }

  .alert-content ul,
  .alert-content ol {
    margin: 0.5rem 0;
    padding-left: 1.5rem;
  }

  .alert-content li {
    margin-bottom: 0.25rem;
  }

  .alert-content li:last-child {
    margin-bottom: 0;
  }

  .alert-content code {
    font-family: 'Consolas', 'Monaco', 'Courier New', monospace;
    font-weight: 600;
  }

  /* Add icon bar on the left */
  .alert::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 4px;
    background: currentColor;
    opacity: 0.3;
    border-radius: 0.5rem 0 0 0.5rem;
  }

  /* Enhance emoji icon */
  .alert::after {
    font-size: var(--alert-icon-size);
    line-height: 1;
  }

  .alert-note::after {
    content: "💡";
  }

  .alert-tip::after {
    content: "✨";
  }

  .alert-warning::after {
    content: "⚠️";
  }

  .alert-danger::after {
    content: "🚫";
  }

  .alert-info::after {
    content: "ℹ️";
  }

  .alert-caution::after {
    content: "⚡";
  }

  /* Add subtle pattern overlay */
  .alert {
    background-image:
      radial-gradient(circle at 20% 50%, rgba(255,255,255,0.1) 0%, transparent 50%),
      radial-gradient(circle at 80% 80%, rgba(255,255,255,0.1) 0%, transparent 50%);
  }
</style>
