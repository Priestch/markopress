<article class="blog-post">
  <header>
    <h1>${$global.title}</h1>
    <div class="meta">
      <span class="date">${$global.date || ''}</span>
      <span class="author"> by ${$global.author || ''}</span>
    </div>
  </header>
  <div class="content">
    $!{$global.content}
  </div>
</article>

