{
  "name": "@markopress/theme-default",
  "version": "1.0.0",
  "description": "Default theme for MarkoPress",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./design-systems": {
      "import": "./dist/design-systems/index.js",
      "types": "./dist/design-systems/index.d.ts"
    },
    "./build": {
      "import": "./dist/build/index.js",
      "types": "./dist/build/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch"
  },
  "marko": {
    "src": "src"
  },
  "files": [
    "src",
    "dist"
  ],
  "keywords": [
    "markopress",
    "theme",
    "marko"
  ],
  "author": "MarkoPress",
  "license": "MIT",
  "devDependencies": {
    "typescript": "^5.3.0"
  }
}
