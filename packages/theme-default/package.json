{
  "name": "@markopress/theme-default",
  "version": "1.0.1",
  "description": "Default theme for MarkoPress",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./design-systems": {
      "import": "./dist/design-systems/index.js",
      "types": "./dist/design-systems/index.d.ts"
    },
    "./build": {
      "import": "./dist/build/index.js",
      "types": "./dist/build/index.d.ts"
    },
    "./dist/tags/*": "./dist/tags/*",
    "./marko.json": "./marko.json",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "npm run build:css && tsc",
    "build:css": "tsx src/build/generate-all.ts",
    "dev": "tsc --watch",
    "dev:css": "tsx watch src/build/generate-all.ts"
  },
  "marko": {
    "src": "src"
  },
  "files": [
    "marko.json",
    "src",
    "dist",
    "public"
  ],
  "keywords": [
    "markopress",
    "theme",
    "marko"
  ],
  "author": "MarkoPress",
  "license": "MIT",
  "devDependencies": {
    "tsx": "^4.7.0",
    "typescript": "^5.3.0"
  }
}
