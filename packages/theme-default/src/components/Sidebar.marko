/*!
 * Sidebar Component
 * Hierarchical navigation with collapsible groups
 */

class {
  onCreate() {
    this.state = {
      openGroups: new Set((input.initialOpenGroups || [])),
    };
  }

  toggleGroup(groupId) {
    if (this.state.openGroups.has(groupId)) {
      this.state.openGroups.delete(groupId);
    } else {
      this.state.openGroups.add(groupId);
    }
    this.setStateDirty('openGroups');
  }

  isGroupOpen(groupId) {
    return this.state.openGroups.has(groupId);
  }

  isActive(href) {
    if (typeof window !== 'undefined') {
      return window.location.pathname === href;
    }
    return false;
  }
}

<div class="sidebar-content">
  <!-- Sidebar Sections -->
  <for|section| of=(input.sections || [])>
    <div class="sidebar-section">
      <!-- Section Header -->
      <if=section.text>
        <div class="sidebar-section-header">${section.text}</div>
      </if>

      <!-- Section Items -->
      <ul class="sidebar-nav">
        <for|item| of=section.items>
          <!-- Item with children (collapsible group) -->
          <if=item.items>
            <li class="sidebar-group">
              <div
                class="sidebar-group-header"
                on-click('toggleGroup', item.text)
                role="button"
                tabindex="0"
                aria-expanded=isGroupOpen(item.text)>
                <span class="sidebar-group-title">${item.text}</span>
                <svg
                  class="sidebar-group-icon"
                  class-list={rotated: isGroupOpen(item.text)}
                  xmlns="http://www.w3.org/2000/svg"
                  width="16"
                  height="16"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2">
                  <polyline points="9 18 15 12 9 6"></polyline>
                </svg>
              </div>

              <if=isGroupOpen(item.text)>
                <ul class="sidebar-group-items">
                  <for|subitem| of=item.items>
                    <li class="sidebar-item">
                      <a
                        class="sidebar-link"
                        href=subitem.link
                        class-list={{
                          active: isActive(subitem.link),
                          'has-icon': subitem.icon
                        }}>
                        <if=subitem.icon>
                          <span class="sidebar-icon">${subitem.icon}</span>
                        </if>
                        <span class="sidebar-text">${subitem.text}</span>
                      </a>
                    </li>
                  </for>
                </ul>
              </if>
            </li>

          <!-- Regular item (no children) -->
          <else>
            <li class="sidebar-item">
              <a
                class="sidebar-link"
                href=item.link
                class-list={{
                  active: isActive(item.link),
                  'has-icon': item.icon
                }}>
                <if=item.icon>
                  <span class="sidebar-icon">${item.icon}</span>
                </if>
                <span class="sidebar-text">${item.text}</span>
              </a>
            </li>
          </if>
        </for>
      </ul>
    </div>
  </for>

  <!-- Sidebar Footer (optional) -->
  <if=input.footer>
    <div class="sidebar-footer">
      <include(input.footer)/>
    </div>
  </if>
</div>

<style>
  .sidebar-content {
    display: flex;
    flex-direction: column;
    gap: var(--space-xl);
  }

  /* Section */
  .sidebar-section {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  .sidebar-section-header {
    padding: var(--space-sm) 0;
    font-size: var(--text-xs);
    font-weight: var(--font-semibold);
    text-transform: uppercase;
    color: var(--text-tertiary);
    letter-spacing: 0.05em;
  }

  /* Navigation List */
  .sidebar-nav {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
  }

  /* Regular Item */
  .sidebar-item {
    list-style: none;
  }

  .sidebar-link {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    padding: var(--space-sm) var(--space-md);
    font-size: var(--text-sm);
    color: var(--text-secondary);
    text-decoration: none;
    border-radius: var(--radius-md);
    transition: all var(--transition-fast);
    line-height: 1.4;
  }

  .sidebar-link:hover {
    color: var(--text-primary);
    background: var(--bg-tertiary);
  }

  .sidebar-link.active {
    color: var(--accent-primary);
    background: var(--accent-bg);
    font-weight: var(--font-medium);
  }

  .sidebar-icon {
    flex-shrink: 0;
    font-size: var(--text-base);
  }

  .sidebar-text {
    flex: 1;
  }

  /* Collapsible Group */
  .sidebar-group {
    display: flex;
    flex-direction: column;
  }

  .sidebar-group-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: var(--space-sm) var(--space-md);
    font-size: var(--text-sm);
    font-weight: var(--font-medium);
    color: var(--text-primary);
    cursor: pointer;
    border-radius: var(--radius-md);
    transition: background-color var(--transition-fast);
    user-select: none;
  }

  .sidebar-group-header:hover {
    background: var(--bg-tertiary);
  }

  .sidebar-group-title {
    flex: 1;
  }

  .sidebar-group-icon {
    flex-shrink: 0;
    transition: transform var(--transition-fast);
  }

  .sidebar-group-icon.rotated {
    transform: rotate(90deg);
  }

  .sidebar-group-items {
    list-style: none;
    padding-left: var(--space-lg);
    margin-top: var(--space-xs);
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
    border-left: 1px solid var(--border-color);
  }

  .sidebar-group-items .sidebar-link {
    font-size: var(--text-sm);
    color: var(--text-secondary);
  }

  /* Sidebar Footer */
  .sidebar-footer {
    margin-top: auto;
    padding-top: var(--space-lg);
    border-top: 1px solid var(--border-color);
  }
</style>
