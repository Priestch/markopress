/*!
 * Theme Toggle Component
 * Dark mode toggle with sun/moon icons, system preference detection, and localStorage persistence
 */

<let/isDark=false/>

<button
  class="theme-toggle"
  aria-label="Toggle dark mode"
  onClick(e) {
    isDark = !isDark;
    if (typeof document !== 'undefined') {
      if (isDark) {
        document.documentElement.classList.add('dark');
      } else {
        document.documentElement.classList.remove('dark');
      }
      localStorage.setItem('theme', isDark ? 'dark' : 'light');
    }
  }>
  <if=!isDark>
    <svg
      class="sun-icon"
      xmlns="http://www.w3.org/2000/svg"
      width="20"
      height="20"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round">
      <circle cx="12" cy="12" r="5"></circle>
      <line x1="12" y1="1" x2="12" y2="3"></line>
      <line x1="12" y1="21" x2="12" y2="23"></line>
      <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
      <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
      <line x1="1" y1="12" x2="3" y2="12"></line>
      <line x1="21" y1="12" x2="23" y2="12"></line>
      <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
      <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
    </svg>
  </if>
  <else>
    <svg
      class="moon-icon"
      xmlns="http://www.w3.org/2000/svg"
      width="20"
      height="20"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round">
      <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
    </svg>
  </else>
</button>

<style>
  .theme-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    padding: 0;
    border: none;
    background: transparent;
    color: var(--text-2);
    cursor: pointer;
    border-radius: var(--radius-md, 8px);
    transition: background-color var(--transition-fast), color var(--transition-fast);
  }

  .theme-toggle:hover {
    background: var(--bg-soft);
    color: var(--text-1);
  }

  .theme-toggle:focus-visible {
    outline: 2px solid var(--color-primary-2, #3a5ccc);
    outline-offset: 2px;
  }

  .sun-icon,
  .moon-icon {
    transition: opacity var(--transition-fast), transform var(--transition-fast);
  }

  .moon-icon {
    animation: moon-rise 0.3s ease-out;
  }

  .sun-icon {
    animation: sun-rise 0.3s ease-out;
  }

  @keyframes moon-rise {
    from {
      opacity: 0;
      transform: rotate(-90deg) scale(0.5);
    }
    to {
      opacity: 1;
      transform: rotate(0) scale(1);
    }
  }

  @keyframes sun-rise {
    from {
      opacity: 0;
      transform: rotate(90deg) scale(0.5);
    }
    to {
      opacity: 1;
      transform: rotate(0) scale(1);
    }
  }
</style>
