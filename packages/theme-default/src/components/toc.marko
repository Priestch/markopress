/**
 * Table of Contents Component
 * Displays page headers with active link highlighting
 */

<let/activeSlug=null/>

<style/styles>
  .nav {
    display: flex;
    flex-direction: column;
  }

  .title {
    font-size: var(--text-sm);
    font-weight: var(--font-semibold);
    margin-bottom: var(--space-md);
    color: var(--text-secondary);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
  }

  .nested {
    padding-left: var(--space-lg);
    margin-top: var(--space-xs);
  }

  .item {
    display: flex;
    flex-direction: column;
  }

  .link {
    display: block;
    padding: var(--space-xs) var(--space-sm);
    font-size: var(--text-sm);
    color: var(--text-secondary);
    text-decoration: none;
    border-left: 2px solid transparent;
    transition: all var(--transition-fast);
    line-height: 1.4;
  }

  .link:hover {
    color: var(--text-primary);
    border-left-color: var(--border-color);
  }

  .link.active {
    color: var(--accent-primary);
    border-left-color: var(--accent-primary);
    font-weight: var(--font-medium);
  }

  .level3 .link,
  .level4 .link {
    font-size: 0.8rem;
  }

  .empty {
    font-size: var(--text-sm);
    color: var(--text-tertiary);
    font-style: italic;
  }
</style>

<nav class=styles.nav>
  <h2 class=styles.title>On This Page</h2>

  <if=input.headers && input.headers.length > 0>
    <ul class=styles.list>
      <for|header| of=input.headers>
        <let/headerClass=styles.item + (header.level === 3 ? ' ' + styles.level3 : '') + (header.level === 4 ? ' ' + styles.level4 : '')/>
        <let/headerLinkClass=styles.link + (activeSlug === header.slug ? ' ' + styles.active : '')/>
        <li class=headerClass>
          <a
            href="#${header.slug}"
            class=headerLinkClass>
            ${header.title}
          </a>

          <!-- Nested children -->
          <if=header.children && header.children.length > 0>
            <ul class=styles.list + ' ' + styles.nested>
              <for|child| of=header.children>
                <let/childClass=styles.item + (child.level === 3 ? ' ' + styles.level3 : '') + (child.level === 4 ? ' ' + styles.level4 : '')/>
                <let/childLinkClass=styles.link + (activeSlug === child.slug ? ' ' + styles.active : '')/>
                <li class=childClass>
                  <a
                    href="#${child.slug}"
                    class=childLinkClass>
                    ${child.title}
                  </a>
                </li>
              </for>
            </ul>
          </if>
        </li>
      </for>
    </ul>
  <else>
    <p class=styles.empty>No headers found</p>
  </else>
</nav>
