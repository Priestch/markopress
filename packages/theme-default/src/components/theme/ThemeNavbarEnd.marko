<!--
  ThemeNavbarEnd - Extension point for end of navbar
  Users can override by creating tags/theme-navbar-end.marko
  Perfect for: GitHub link, language switcher, dark mode toggle, search, etc.
-->

class {
  onCreate() {
    this.mobileMenuOpen = input.mobileMenuOpen || false;
  }

  toggleMobileMenu() {
    this.mobileMenuOpen = !this.mobileMenuOpen;
    // Emit event or call parent method
    if (input.onMenuToggle) {
      input.onMenuToggle(this.mobileMenuOpen);
    }
  }
}

<div class="navbar-actions">
  <!-- Search Component with Keyboard Shortcut -->
  <components.Search/>

  <!-- Theme Toggle (Dark Mode) -->
  <components.ThemeToggle/>

  <!-- Mobile Menu Toggle -->
  <button class="btn-icon mobile-menu-toggle" aria-label="Toggle menu" on-click('toggleMobileMenu')>
    <if=this.mobileMenuOpen>
      <!-- Close Icon -->
      <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <line x1="18" y1="6" x2="6" y2="18"></line>
        <line x1="6" y1="6" x2="18" y2="18"></line>
      </svg>
    <else>
      <!-- Menu Icon -->
      <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <line x1="3" y1="12" x2="21" y2="12"></line>
        <line x1="3" y1="6" x2="21" y2="6"></line>
        <line x1="3" y1="18" x2="21" y2="18"></line>
      </svg>
    </if>
  </button>
</div>
