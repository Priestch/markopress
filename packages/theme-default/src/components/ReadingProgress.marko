/*!
 * Reading Progress Indicator Component
 * Subtle progress bar at top of page showing scroll progress
 */

class {
  onCreate() {
    this.state = {
      progress: 0,
    };
  }

  onMount() {
    if (typeof window === 'undefined') return;

    this.updateProgress = () => {
      if (typeof document === 'undefined') return;

      const windowHeight = window.innerHeight;
      const documentHeight = document.documentElement.scrollHeight;
      const scrollTop = window.scrollY;
      const scrollableHeight = documentHeight - windowHeight;

      this.state.progress = scrollableHeight > 0
        ? (scrollTop / scrollableHeight) * 100
        : 0;
    };

    // Throttled update for performance
    let ticking = false;
    this.onScroll = () => {
      if (!ticking) {
        window.requestAnimationFrame(() => {
          this.updateProgress();
          ticking = false;
        });
        ticking = true;
      }
    };

    window.addEventListener('scroll', this.onScroll, { passive: true });
    this.updateProgress();
  }

  onDestroy() {
    if (this.onScroll) {
      window.removeEventListener('scroll', this.onScroll);
    }
  }
}

<div class="reading-progress">
  <div
    class="reading-progress-bar"
    style={width: state.progress + '%'}></div>
</div>

<style>
  .reading-progress {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    height: 2px;
    background: transparent;
    z-index: 9999;
    pointer-events: none;
  }

  .reading-progress-bar {
    height: 100%;
    background: var(--color-primary-2, rgba(100, 108, 255, 0.3));
    transition: width 100ms linear;
  }

  /* Reduced motion support */
  @media (prefers-reduced-motion: reduce) {
    .reading-progress-bar {
      transition: none;
    }
  }
</style>
