/*!
 * Footer Component
 * Simple footer with copyright and links
 */

<footer class="footer">
  <p>
    © ${new Date().getFullYear()} ${input.siteName || 'MarkoPress'}.
    Built with <a href="https://markojs.com" target="_blank" rel="noopener">Marko.js</a>.
  </p>

  <if(input.links)>
    <div class="footer-links">
      <for|link| of=input.links>
        <a href="${link.url}" target="${link.target || '_self'}">${link.text}</a>
      </for>
    </div>
  </if>
</footer>

<style>`
  .footer {
    text-align: center;
    padding: 2rem;
    margin-top: 4rem;
    color: var(--text-secondary);
    border-top: 1px solid var(--border-color);
  }

  .footer a {
    color: var(--accent-color);
    text-decoration: none;
  }

  .footer a:hover {
    text-decoration: underline;
  }

  .footer-links {
    margin-top: 1rem;
    display: flex;
    gap: 1.5rem;
    justify-content: center;
  }
`</style>
