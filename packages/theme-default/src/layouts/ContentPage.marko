/*!
 * Content Page Layout
 * For displaying individual pages, documentation, and blog posts
 */

<div class="content-viewer">
  <h1>${input.title}</h1>
  <include(input.content)/>

  <!-- Prev/Next Navigation (for docs) -->
  <if(input.navigation)>
    <div class="doc-nav">
      <if(input.navigation.prev)>
        <a class="doc-nav-link prev"
           href="#"
           onclick=input.navigation.prev.onClick>
          <span class="doc-nav-label">← Previous</span>
          <span class="doc-nav-title">${input.navigation.prev.title}</span>
        </a>
      </if>
      <if(!input.navigation.prev)>
        <div class="doc-nav-separator"></div>
      </if>

      <if(input.navigation.next)>
        <a class="doc-nav-link next"
           href="#"
           onclick=input.navigation.next.onClick>
          <span class="doc-nav-label">Next →</span>
          <span class="doc-nav-title">${input.navigation.next.title}</span>
        </a>
      </if>
      <if(!input.navigation.next)>
        <div class="doc-nav-separator"></div>
      </if>
    </div>
  </if>

  <!-- Back Link -->
  <a class="back-link" href="#" onclick=input.onBack>← Back to Home</a>
</div>
