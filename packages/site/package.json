{
  "name": "@markopress/site",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "markopress dev",
    "build": "markopress build",
    "dev:vite": "marko-run dev",
