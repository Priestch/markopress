// 页面级槽位：正文 article（.mp-doc scope）+ 右栏 TOC + prev/next。
//
// input 契约（生成器的 +page.marko 包装提供）：
//   page { data, segments, headings } —— 虚拟模块导出（per-page，digest 缓存）；
//       segments 含 html 段（$!{html} 注入）与 component 段（md 内 <tag/>，
//       scripts/segments.ts 产出，动态 tag 渲染 + Marko 水合）
//   nav  { prev, next }               —— page-nav.js 从 sidebar flat 序算的邻居
//                                         （{ title, href } | null；跨文件数据走 sidebar.json
//                                          模块图失效，不进虚拟模块的 per-entry 缓存）
//
// TOC 用编译期 headings（h2–h3；h1 是页标题不进目录——四家共识，themes.md §6），
// 先过滤后渲染天然不会误挂层级（headings 本身就是文档序扁平表）。
// scrollspy 脚本在 mp-layout 页尾（每页一份，避免 per-page 重复内联）。
<const/toc=(input.page.headings ?? []).filter((h) => h.depth >= 2 && h.depth <= 3)>

// 正文排版归本主题（.mp-doc scope）；内容契约的机械部分（mp-image/容器/shiki 切换）
// 经 <mp-content-styles/> 来自 markopress-theme-base。$!{seg.html} 注入的内容没有组件边界，
// 裸元素选择器会泄漏到全站（VitePress .vp-doc 的教训，themes.md §7）。
<style>
  .mp-page {
    display: grid;
    grid-template-columns: minmax(0, 1fr) var(--mp-toc-w);
    gap: 48px;
    max-width: calc(var(--mp-content-w) + var(--mp-toc-w) + 48px);
    margin: 0 auto;
    padding: 32px 20px 64px;
  }
  .mp-doc-title { font-size: 32px; line-height: 1.25; margin: 0 0 24px; }

  .mp-doc h2 { margin-top: 32px; border-bottom: 1px solid var(--mp-border); padding-bottom: 8px; }
  .mp-doc h3 { margin-top: 24px; }
  .mp-doc a { color: var(--mp-accent); }
  .mp-doc img { max-width: 100%; }

  /* .mp-image 家族 / .mp-container 家族 / shiki 双主题切换 → markopress-theme-base */

  .mp-doc pre.shiki {
    padding: 12px 16px;
    border-radius: 8px;
    overflow-x: auto;
    line-height: 1.5;
    background: #ffffff;
  }
  .mp-doc code { font-family: var(--mp-font-mono); font-size: 14px; }

  /* 右栏 TOC（sticky；scrollspy 高亮 .active） */
  .mp-toc {
    position: sticky;
    top: 88px;
    align-self: start;
    max-height: calc(100vh - 120px);
    overflow-y: auto;
    font-size: 13px;
  }
  .mp-toc-title { font-weight: 600; margin-bottom: 8px; color: var(--mp-fg-muted); }
  .mp-toc a {
    display: block;
    padding: 3px 0 3px 12px;
    color: var(--mp-fg-muted);
    text-decoration: none;
    border-left: 2px solid transparent;
  }
  .mp-toc a.toc-h3 { padding-left: 24px; }
  .mp-toc a:hover { color: var(--mp-fg); }
  .mp-toc a.active { color: var(--mp-accent); border-left-color: var(--mp-accent); }

  /* prev/next：sidebar 平铺序派生（themes.md §6——四家无一手配此项） */
  .mp-pagination {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    margin-top: 48px;
    padding-top: 16px;
    border-top: 1px solid var(--mp-border);
  }
  .mp-pagination a {
    color: var(--mp-accent);
    text-decoration: none;
    font-size: 14px;
    max-width: 45%;
  }
  .mp-pagination a:hover { text-decoration: underline; }

  @media (max-width: 960px) {
    .mp-page { grid-template-columns: minmax(0, 1fr); }
    .mp-toc { display: none; }
  }
</style>

<div class="mp-page">
  <article class="mp-doc">
    <mp-content-styles/>
    <h1 class="mp-doc-title">${input.page.data.title}</h1>
    <for|seg| of=input.page.segments>
      <if=seg.type === "html">
        $!{seg.html}
      </if>
      <else>
        <${seg.component}/>
      </else>
    </for>
    <nav class="mp-pagination">
      <if=input.nav?.prev>
        <a href=input.nav.prev.href>← ${input.nav.prev.title}</a>
      </if>
      <else>
        <span/>
      </else>
      <if=input.nav?.next>
        <a href=input.nav.next.href>${input.nav.next.title} →</a>
      </if>
    </nav>
  </article>
  <if=toc.length>
    <aside class="mp-toc">
      <div class="mp-toc-title">On this page</div>
      <nav>
        <for|h| of=toc>
          <a class=("toc-h" + h.depth) href=("#" + h.slug)>${h.text}</a>
        </for>
      </nav>
    </aside>
  </if>
</div>
