<div class="content">
  <h1>${$global.title}</h1>
  <div class="content-body" no-parse>
    <h1 id="build-api" tabindex="-1"><a class="header-anchor" href="#build-api">#</a> Build API</h1>
<p>Programmatic API for building sites.</p>
<h2 id="build()" tabindex="-1"><a class="header-anchor" href="#build()">#</a> build()</h2>
<p>Build your site programmatically:</p>
<pre class="shiki github-light line-numbers"><code><span class="line" data-line="1"><span class="line"><span style="color:#D73A49">import</span><span style="color:#24292E"> { build } </span><span style="color:#D73A49">from</span><span style="color:#032F62"> 'markopress/build'</span><span style="color:#24292E">;</span></span></span>
<span class="line" data-line="2"><span class="line"></span></span>
<span class="line" data-line="3"><span class="line"><span style="color:#D73A49">const</span><span style="color:#005CC5"> result</span><span style="color:#D73A49"> =</span><span style="color:#D73A49"> await</span><span style="color:#6F42C1"> build</span><span style="color:#24292E">({</span></span></span>
<span class="line" data-line="4"><span class="line"><span style="color:#24292E">  outDir: </span><span style="color:#032F62">'dist'</span><span style="color:#24292E">,</span></span></span>
<span class="line" data-line="5"><span class="line"><span style="color:#24292E">  debug: </span><span style="color:#005CC5">false</span><span style="color:#24292E">,</span></span></span>
<span class="line" data-line="6"><span class="line"><span style="color:#24292E">});</span></span></span>
<span class="line" data-line="7"><span class="line"></span></span>
<span class="line" data-line="8"><span class="line"><span style="color:#24292E">console.</span><span style="color:#6F42C1">log</span><span style="color:#24292E">(</span><span style="color:#032F62">`Built $\{</span><span style="color:#24292E">result</span><span style="color:#032F62">.</span><span style="color:#24292E">pages</span><span style="color:#032F62">} pages`</span><span style="color:#24292E">);</span></span></span>
<span class="line" data-line="9"><span class="line"></span></span></code></pre>
<h2 id="build-options" tabindex="-1"><a class="header-anchor" href="#build-options">#</a> Build Options</h2>
<pre class="shiki github-light line-numbers"><code><span class="line" data-line="1"><span class="line"><span style="color:#D73A49">interface</span><span style="color:#6F42C1"> BuildOptions</span><span style="color:#24292E"> {</span></span></span>
<span class="line" data-line="2"><span class="line"><span style="color:#E36209">  outDir</span><span style="color:#D73A49">?:</span><span style="color:#005CC5"> string</span><span style="color:#24292E">;    </span><span style="color:#6A737D">// Output directory</span></span></span>
<span class="line" data-line="3"><span class="line"><span style="color:#E36209">  debug</span><span style="color:#D73A49">?:</span><span style="color:#005CC5"> boolean</span><span style="color:#24292E">;    </span><span style="color:#6A737D">// Enable debug logging</span></span></span>
<span class="line" data-line="4"><span class="line"><span style="color:#24292E">}</span></span></span>
<span class="line" data-line="5"><span class="line"></span></span></code></pre>
<h2 id="build-result" tabindex="-1"><a class="header-anchor" href="#build-result">#</a> Build Result</h2>
<pre class="shiki github-light line-numbers"><code><span class="line" data-line="1"><span class="line"><span style="color:#D73A49">interface</span><span style="color:#6F42C1"> BuildResult</span><span style="color:#24292E"> {</span></span></span>
<span class="line" data-line="2"><span class="line"><span style="color:#E36209">  success</span><span style="color:#D73A49">:</span><span style="color:#005CC5"> boolean</span><span style="color:#24292E">;   </span><span style="color:#6A737D">// Build success status</span></span></span>
<span class="line" data-line="3"><span class="line"><span style="color:#E36209">  outDir</span><span style="color:#D73A49">:</span><span style="color:#005CC5"> string</span><span style="color:#24292E">;     </span><span style="color:#6A737D">// Output directory path</span></span></span>
<span class="line" data-line="4"><span class="line"><span style="color:#E36209">  pages</span><span style="color:#D73A49">:</span><span style="color:#005CC5"> number</span><span style="color:#24292E">;      </span><span style="color:#6A737D">// Total pages built</span></span></span>
<span class="line" data-line="5"><span class="line"><span style="color:#E36209">  errors</span><span style="color:#D73A49">:</span><span style="color:#005CC5"> string</span><span style="color:#24292E">[];   </span><span style="color:#6A737D">// Build errors</span></span></span>
<span class="line" data-line="6"><span class="line"><span style="color:#24292E">}</span></span></span>
<span class="line" data-line="7"><span class="line"></span></span></code></pre>
<h2 id="build-process" tabindex="-1"><a class="header-anchor" href="#build-process">#</a> Build Process</h2>
<p>The build process consists of:</p>
<ol>
<li>Load configuration</li>
<li>Scan content directories</li>
<li>Generate route files</li>
<li>Build with @marko/run</li>
<li>Optimize output</li>
</ol>
<h2 id="hooks" tabindex="-1"><a class="header-anchor" href="#hooks">#</a> Hooks</h2>
<p>Use hooks to customize the build:</p>
<pre class="shiki github-light line-numbers"><code><span class="line" data-line="1"><span class="line"><span style="color:#D73A49">export</span><span style="color:#D73A49"> default</span><span style="color:#6F42C1"> defineConfig</span><span style="color:#24292E">({</span></span></span>
<span class="line" data-line="2"><span class="line"><span style="color:#24292E">  plugins: [</span></span></span>
<span class="line" data-line="3"><span class="line"><span style="color:#24292E">    {</span></span></span>
<span class="line" data-line="4"><span class="line"><span style="color:#24292E">      name: </span><span style="color:#032F62">'my-plugin'</span><span style="color:#24292E">,</span></span></span>
<span class="line" data-line="5"><span class="line"><span style="color:#6F42C1">      beforeBuild</span><span style="color:#24292E">(</span><span style="color:#E36209">ctx</span><span style="color:#24292E">) {</span></span></span>
<span class="line" data-line="6"><span class="line"><span style="color:#24292E">        console.</span><span style="color:#6F42C1">log</span><span style="color:#24292E">(</span><span style="color:#032F62">'Building...'</span><span style="color:#24292E">);</span></span></span>
<span class="line" data-line="7"><span class="line"><span style="color:#24292E">      },</span></span></span>
<span class="line" data-line="8"><span class="line"><span style="color:#6F42C1">      afterBuild</span><span style="color:#24292E">(</span><span style="color:#E36209">ctx</span><span style="color:#24292E">) {</span></span></span>
<span class="line" data-line="9"><span class="line"><span style="color:#24292E">        console.</span><span style="color:#6F42C1">log</span><span style="color:#24292E">(</span><span style="color:#032F62">'Done!'</span><span style="color:#24292E">);</span></span></span>
<span class="line" data-line="10"><span class="line"><span style="color:#24292E">      },</span></span></span>
<span class="line" data-line="11"><span class="line"><span style="color:#24292E">    },</span></span></span>
<span class="line" data-line="12"><span class="line"><span style="color:#24292E">  ],</span></span></span>
<span class="line" data-line="13"><span class="line"><span style="color:#24292E">});</span></span></span>
<span class="line" data-line="14"><span class="line"></span></span></code></pre>
<p>See also:</p>
<ul>
<li><a href="/docs/api/routes">Routes API</a></li>
<li><a href="/docs/api/markdown">Markdown API</a></li>
</ul>

