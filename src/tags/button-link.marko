/**
 * Button Link Tag
 *
 * Usage in markdown:
 * <button-link href="https://example.com" kind="primary">Click Me</button-link>
 *
 * Kinds: primary, secondary, outline, ghost
 * Sizes: sm, md, lg
 */

<a
  href=input.href
  class=["btn", "btn-" + (input.kind || 'primary'), "btn-" + (input.size || 'md')]
  target=input.target||"_blank"
  rel=input.target?"noopener noreferrer":null
>
  <${input.content}/>
</a>

<style>
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    padding: 0.625rem 1.25rem;
    font-size: 0.9375rem;
    font-weight: 500;
    border-radius: 6px;
    text-decoration: none;
    transition: all 0.2s;
    cursor: pointer;
    border: 2px solid transparent;
  }

  /* Sizes */
  .btn-sm {
    padding: 0.375rem 0.875rem;
    font-size: 0.875rem;
  }

  .btn-md {
    padding: 0.625rem 1.25rem;
    font-size: 0.9375rem;
  }

  .btn-lg {
    padding: 0.875rem 1.75rem;
    font-size: 1rem;
  }

  /* Kinds */
  .btn-primary {
    background: #3c8772;
    color: white;
    border-color: #3c8772;
  }

  .btn-primary:hover {
    background: #31705f;
    border-color: #31705f;
    transform: translateY(-1px);
    box-shadow: 0 4px 6px rgba(60, 135, 114, 0.2);
  }

  .btn-secondary {
    background: #6b7280;
    color: white;
    border-color: #6b7280;
  }

  .btn-secondary:hover {
    background: #4b5563;
    border-color: #4b5563;
    transform: translateY(-1px);
  }

  .btn-outline {
    background: transparent;
    color: #3c8772;
    border-color: #3c8772;
  }

  .btn-outline:hover {
    background: #3c8772;
    color: white;
    transform: translateY(-1px);
  }

  .btn-ghost {
    background: transparent;
    color: #6b7280;
    border-color: transparent;
  }

  .btn-ghost:hover {
    background: #f3f4f6;
    color: #111827;
  }
</style>
