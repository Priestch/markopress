  &lt;input type=&quot;email&quot; value=state.email onInput=&gt;handleEmailInput(e) /&gt;
  &lt;p&gt;Email: $\{state.email}&lt;/p&gt;

  &lt;button onClick=&gt;handleSubmit()&gt;Submit&lt;/button&gt;
&lt;/div&gt;
