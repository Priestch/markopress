<h3 id="input-events" tabindex="-1"><a class="header-anchor" href="#input-events">#</a> Input Events</h3>
<pre><code class="language-marko">class {
  onCreate() {
    this.state = {
      text: '',
      email: '',
    };
  }

  handleTextInput(e) {
    this.state.text = e.target.value;
  }

  handleEmailInput(e) {
    this.state.email = e.target.value;
  }

  handleSubmit() {
    console.log({
      text: this.state.text,
      email: this.state.email,
    });
  }
}

&lt;div&gt;
