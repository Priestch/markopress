<span class="line"><span style="color:#D73A49">      if</span><span style="color:#24292E"> (</span><span style="color:#D73A49">!</span><span style="color:#24292E">enabled) </span><span style="color:#D73A49">return</span><span style="color:#24292E"> config;</span></span>
<span class="line"></span>
<span class="line"><span style="color:#6A737D">      // Use options</span></span>
<span class="line"><span style="color:#24292E">      config.site.customField </span><span style="color:#D73A49">=</span><span style="color:#24292E"> customOption;</span></span>
<span class="line"></span>
<span class="line"><span style="color:#D73A49">      return</span><span style="color:#24292E"> config;</span></span>
<span class="line"><span style="color:#24292E">    },</span></span>
