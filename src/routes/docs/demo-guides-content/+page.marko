<span class="line"><span style="color:#24292E">          ctx.utils.</span><span style="color:#6F42C1">warn</span><span style="color:#24292E">(</span><span style="color:#032F62">`Missing title: $\{</span><span style="color:#24292E">page</span><span style="color:#032F62">.</span><span style="color:#24292E">filePath</span><span style="color:#032F62">}`</span><span style="color:#24292E">);</span></span>
