<h3 id="dynamic-styling" tabindex="-1"><a class="header-anchor" href="#dynamic-styling">#</a> Dynamic Styling</h3>
<p>Use Marko’s reactivity for dynamic styling:</p>
<pre><code class="language-marko">&lt;!-- .markopress/theme/components/ThemeSwitcher.marko --&gt;

class {
  onCreate() {
    this.state = {
      theme: localStorage.getItem('theme') || 'light',
    };

    if (this.state.theme === 'dark') {
      document.body.classList.add('dark-mode');
    }
  }

  setTheme(theme) {
    this.state.theme = theme;
    localStorage.setItem('theme', theme);

    if (theme === 'dark') {
      document.body.classList.add('dark-mode');
    } else {
      document.body.classList.remove('dark-mode');
    }
  }
}

&lt;div class=&quot;theme-switcher&quot;&gt;
  &lt;button
    class=$\{['theme-btn', { active: state.theme === 'light' }]}
    onClick=&gt;setTheme('light')
  &gt;
    ☀️ Light
  &lt;/button&gt;
  &lt;button
    class=$\{['theme-btn', { active: state.theme === 'dark' }]}
    onClick=&gt;setTheme('dark')
  &gt;
    🌙 Dark
  &lt;/button&gt;
&lt;/div&gt;
</code></pre>
