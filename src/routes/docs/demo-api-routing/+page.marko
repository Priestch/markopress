<span class="line"><span style="color:#D73A49">    return</span><span style="color:#24292E"> Response.</span><span style="color:#6F42C1">redirect</span><span style="color:#24292E">(</span><span style="color:#032F62">'/login'</span><span style="color:#24292E">);</span></span>
<span class="line"><span style="color:#24292E">  }</span></span>
