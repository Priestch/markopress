<span class="line"><span style="color:#24292E">};</span></span>
<span class="line"></span>
<span class="line"><span style="color:#6A737D">// Use in route</span></span>
<span class="line"><span style="color:#D73A49">export</span><span style="color:#D73A49"> const</span><span style="color:#005CC5"> GET</span><span style="color:#D73A49"> =</span><span style="color:#24292E"> [</span></span>
