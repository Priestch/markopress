<span class="line"><span style="color:#D73A49">  return</span><span style="color:#D73A49"> new</span><span style="color:#6F42C1"> Response</span><span style="color:#24292E">(</span><span style="color:#005CC5">JSON</span><span style="color:#24292E">.</span><span style="color:#6F42C1">stringify</span><span style="color:#24292E">({ received: body }));</span></span>
<span class="line"><span style="color:#24292E">};</span></span>
