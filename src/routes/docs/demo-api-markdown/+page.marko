<span class="line"><span style="color:#24292E">![</span><span style="color:#032F62;text-decoration:underline">Alt text</span><span style="color:#24292E">](</span><span style="color:#24292E;text-decoration:underline">image.jpg</span><span> </span><span style="color:#032F62;text-decoration:underline">"Image title"</span><span style="color:#24292E">)</span></span>
