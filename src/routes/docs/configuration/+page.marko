<span class="line"><span style="color:#24292E">              { text: </span><span style="color:#032F62">'Installation'</span><span style="color:#24292E">, link: </span><span style="color:#032F62">'/docs/guide/installation'</span><span style="color:#24292E"> },</span></span>
