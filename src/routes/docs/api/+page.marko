<span class="line"><span style="color:#E36209">  collapsed</span><span style="color:#D73A49">?:</span><span style="color:#005CC5"> boolean</span><span style="color:#24292E">;  </span><span style="color:#6A737D">// Default: false</span></span>
<span class="line"><span style="color:#E36209">  items</span><span style="color:#D73A49">:</span><span style="color:#6F42C1"> Array</span><span style="color:#24292E">&#x3C;{</span></span>
<span class="line"><span style="color:#E36209">    text</span><span style="color:#D73A49">:</span><span style="color:#005CC5"> string</span><span style="color:#24292E">;      </span><span style="color:#6A737D">// Link text</span></span>
<span class="line"><span style="color:#E36209">    link</span><span style="color:#D73A49">:</span><span style="color:#005CC5"> string</span><span style="color:#24292E">;      </span><span style="color:#6A737D">// URL path</span></span>
<span class="line"><span style="color:#E36209">    items</span><span style="color:#D73A49">?:</span><span style="color:#6F42C1"> SidebarItem</span><span style="color:#24292E">[];  </span><span style="color:#6A737D">// Nested items</span></span>
<span class="line"><span style="color:#24292E">  }>;</span></span>
<span class="line"><span style="color:#24292E">}</span></span>
<span class="line"></span></code></pre>
<p><strong>Footer:</strong></p>
<pre class="shiki github-light" style="background-color:#fff;color:#24292e" tabindex="0"><code><span class="line"><span style="color:#D73A49">interface</span><span style="color:#6F42C1"> FooterConfig</span><span style="color:#24292E"> {</span></span>
<span class="line"><span style="color:#E36209">  copyright</span><span style="color:#D73A49">?:</span><span style="color:#005CC5"> string</span><span style="color:#24292E">;  </span><span style="color:#6A737D">// Use {year} placeholder</span></span>
<span class="line"><span style="color:#E36209">  links</span><span style="color:#D73A49">?:</span><span style="color:#6F42C1"> Array</span><span style="color:#24292E">&#x3C;{</span></span>
