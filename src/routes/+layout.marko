<!DOCTYPE html>
<html lang=$global.lang||"en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>${$global.title || 'MarkoPress'}</title>
  <if=$global.description>
    <meta name="description" content=$global.description>
  </if>
  <style>
    /* Import theme styles */
    <include('../packages/theme-default/src/styles.css')/>
  </style>
</head>
<body>
  <!-- Background Pattern -->
  <div class="background-pattern"></div>

  <div class="app-container">
    <!-- Navbar -->
    <header class="navbar">
      <div class="navbar-container">
        <!-- Logo and Site Title -->
        <a href="/" class="navbar-brand">
          <span class="navbar-title">MarkoPress</span>
        </a>

        <!-- Desktop Navigation -->
        <nav class="navbar-nav">
          <a class="nav-link" href="/">Home</a>
          <a class="nav-link" href="/about">About</a>
          <a class="nav-link" href="/contact">Contact</a>
        </nav>

        <!-- Header Actions -->
        <div class="navbar-actions">
          <!-- Dark Mode Toggle -->
          <button class="btn-icon" aria-label="Toggle dark mode" on-click=toggleDarkMode>
            <span class="icon-sun">☀️</span>
            <span class="icon-moon">🌙</span>
          </button>

          <!-- Mobile Menu Toggle -->
          <button class="btn-icon mobile-menu-toggle" aria-label="Toggle menu" on-click=toggleMobileMenu>
            <span class="icon-menu">☰</span>
            <span class="icon-close">✕</span>
          </button>
        </div>
      </div>
    </header>

    <!-- Main Content -->
    <main class="main-content">
      <${input.content}/>
    </main>

    <!-- Footer -->
    <footer class="footer">
      <div class="footer-content">
        <p>© ${new Date().getFullYear()} MarkoPress. Built with Marko.js.</p>
      </div>
    </footer>
  </div>

  <script>
    class Layout {
      state = {
        darkMode: false,
        mobileMenuOpen: false,
      };

      onMount() {
        // Check for saved theme preference
        const savedTheme = localStorage.getItem('theme');
        const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;

        if (savedTheme === 'dark' || (!savedTheme && prefersDark)) {
          this.state.darkMode = true;
          document.documentElement.classList.add('dark');
        }

        this.updateUI();
      }

      toggleDarkMode() {
        this.state.darkMode = !this.state.darkMode;
        document.documentElement.classList.toggle('dark', this.state.darkMode);
        localStorage.setItem('theme', this.state.darkMode ? 'dark' : 'light');
        this.updateUI();
      }

      toggleMobileMenu() {
        this.state.mobileMenuOpen = !this.state.mobileMenuOpen;
        this.updateUI();
      }

      updateUI() {
        // Update dark mode icons
        const sunIcon = this.getEl('sun-icon');
        const moonIcon = this.getEl('moon-icon');
        if (sunIcon && moonIcon) {
          sunIcon.style.display = this.state.darkMode ? 'inline' : 'none';
          moonIcon.style.display = this.state.darkMode ? 'none' : 'inline';
        }

        // Update mobile menu icons
        const menuIcon = this.getEl('menu-icon');
        const closeIcon = this.getEl('close-icon');
        if (menuIcon && closeIcon) {
          menuIcon.style.display = this.state.mobileMenuOpen ? 'none' : 'inline';
          closeIcon.style.display = this.state.mobileMenuOpen ? 'inline' : 'none';
        }
      }
    }
  </script>

  <style>
    .icon-sun, .icon-moon, .icon-menu, .icon-close {
      font-size: 1.2rem;
      line-height: 1;
    }

    .icon-moon, .icon-close {
      display: none;
    }

    .dark .icon-sun {
      display: inline;
    }

    .dark .icon-moon {
      display: none;
    }
  </style>
</body>
</html>
