<!--
  Custom Navbar Start Override
  This overrides the default theme-navbar-start component
-->

class {
  onCreate() {
    this.siteTitle = input.siteTitle || 'MarkoPress';
    this.logo = input.logo;
    this.url = input.url || '/';
  }
}

<a href=this.url class="navbar-brand custom-override">
  <if=this.logo>
    <img src=this.logo alt="Logo" class="navbar-logo">
  </if>
  <span class="navbar-title">${this.siteTitle}</span>
  <span class="override-badge">CUSTOM</span>
</a>

<style>
  .override-badge {
    background: #ff6b6b;
    color: white;
    padding: 2px 6px;
    border-radius: 4px;
    font-size: 10px;
    margin-left: 8px;
    font-weight: bold;
  }
</style>
