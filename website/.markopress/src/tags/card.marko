<style>
  .card {
    --card-bg: var(--bg-elevated, #ffffff);
    --card-ring: var(--border-default, #e5e7eb);
    --card-shadow: rgba(15, 23, 42, 0.5);
    border: 1px solid var(--card-ring);
    border-radius: 14px;
    margin: 1rem 0;
    overflow: hidden;
    background: linear-gradient(180deg, color-mix(in srgb, var(--card-bg) 94%, var(--bg-alt, #f8fafc)), var(--card-bg));
    transition: box-shadow 0.16s ease, transform 0.16s ease, border-color 0.16s ease;
    position: relative;
    isolation: isolate;
  }

  .card--elevated {
    box-shadow: 0 18px 38px -32px var(--card-shadow);
  }

  .card--hoverable:hover {
    transform: translateY(-1px);
    border-color: color-mix(in srgb, var(--color-primary-1, #3451b2) 34%, var(--card-ring));
    box-shadow: 0 24px 42px -28px color-mix(in srgb, var(--card-shadow) 82%, black);
  }

  .card--outlined {
    box-shadow: none;
  }

  .card--has-tone::before {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    height: 3px;
    background: linear-gradient(
      90deg,
      color-mix(in srgb, var(--card-tone, var(--color-primary-1, #3451b2)) 82%, white),
      var(--card-tone, var(--color-primary-1, #3451b2))
    );
    z-index: 1;
  }

  .card--tone-primary {
    --card-tone: var(--color-primary-1, #3451b2);
    --card-ring: color-mix(in srgb, var(--color-primary-1, #3451b2) 30%, var(--border-default, #e5e7eb));
    background:
      radial-gradient(circle at top right, color-mix(in srgb, var(--color-primary-2, #3c8772) 18%, transparent), transparent 40%),
      linear-gradient(180deg, color-mix(in srgb, var(--color-primary-soft, #dbeafe) 58%, white), var(--bg-elevated, #ffffff));
  }

  .card--tone-muted {
    --card-tone: var(--color-gray-1, #6b7280);
    background: linear-gradient(180deg, var(--bg-alt, #f9fafb), color-mix(in srgb, var(--bg-alt, #f9fafb) 80%, white));
  }

  .card--tone-success {
    --card-tone: var(--color-success-1, #16a34a);
    --card-ring: color-mix(in srgb, var(--color-success-1, #16a34a) 34%, var(--border-default, #e5e7eb));
    background: linear-gradient(180deg, color-mix(in srgb, var(--color-success-3, #86efac) 36%, white), var(--bg-elevated, #ffffff));
  }

  .card--tone-danger {
    --card-tone: var(--color-danger-1, #dc2626);
    --card-ring: color-mix(in srgb, var(--color-danger-1, #dc2626) 34%, var(--border-default, #e5e7eb));
    background: linear-gradient(180deg, color-mix(in srgb, var(--color-danger-3, #fca5a5) 30%, white), var(--bg-elevated, #ffffff));
  }

  .card--tone-warning {
    --card-tone: var(--color-warning-1, #d97706);
    --card-ring: color-mix(in srgb, var(--color-warning-1, #d97706) 34%, var(--border-default, #e5e7eb));
    background: linear-gradient(180deg, color-mix(in srgb, var(--color-warning-3, #fde68a) 34%, white), var(--bg-elevated, #ffffff));
  }

  .card--tone-info {
    --card-tone: var(--color-info-1, #0891b2);
    --card-ring: color-mix(in srgb, var(--color-info-1, #0891b2) 34%, var(--border-default, #e5e7eb));
    background: linear-gradient(180deg, color-mix(in srgb, var(--color-info-3, #cffafe) 34%, white), var(--bg-elevated, #ffffff));
  }

  .card:focus-within {
    outline: 2px solid color-mix(in srgb, var(--color-primary-1, #3451b2) 46%, white);
    outline-offset: 2px;
  }
</style>

<div
  class=("card"
    + (input.elevated === false ? "" : " card--elevated")
    + (input.hoverable ? " card--hoverable" : "")
    + (input.outlined ? " card--outlined" : "")
    + (input.tone && input.tone !== "default" ? " card--has-tone card--tone-" + input.tone : ""))
>
  <${input.content}/>
</div>
