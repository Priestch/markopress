<style>
  .alert-box {
    --alert-accent: var(--color-info-1, #0891b2);
    --alert-soft: var(--color-info-3, #cffafe);
    --alert-bg: color-mix(in srgb, var(--alert-soft) 62%, var(--bg-elevated, #ffffff));
    --alert-fg: var(--text-1, #0f172a);
    --alert-ring: color-mix(in srgb, var(--alert-accent) 34%, var(--border-default, #e5e7eb));
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.9rem;
    align-items: start;
    margin: 1rem 0;
    padding: 0.95rem 1rem;
    border-radius: 14px;
    border: 1px solid var(--alert-ring);
    background: linear-gradient(180deg, color-mix(in srgb, var(--alert-bg) 84%, white), var(--alert-bg));
    color: var(--alert-fg);
    box-shadow: 0 14px 28px -24px color-mix(in srgb, var(--alert-accent) 50%, black);
    position: relative;
    overflow: hidden;
    isolation: isolate;
  }

  .alert-box::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 4px;
    background: linear-gradient(180deg, color-mix(in srgb, var(--alert-accent) 88%, white), var(--alert-accent));
  }

  .alert-box::after {
    content: "";
    position: absolute;
    right: -18%;
    top: -36%;
    width: 52%;
    height: 140%;
    background: radial-gradient(
      circle,
      color-mix(in srgb, var(--alert-accent) 18%, transparent),
      transparent 65%
    );
    pointer-events: none;
  }

  .alert-box__icon {
    width: 1.42rem;
    height: 1.42rem;
    border-radius: 999px;
    display: grid;
    place-items: center;
    font-size: 0.83rem;
    font-weight: 700;
    color: var(--alert-accent);
    background: color-mix(in srgb, var(--alert-accent) 15%, white);
    border: 1px solid color-mix(in srgb, var(--alert-accent) 32%, white);
    line-height: 1;
    margin-top: 0.03rem;
    flex: 0 0 auto;
  }

  .alert-box__icon::before {
    content: "i";
  }

  .alert-box__icon--custom::before {
    content: "";
  }

  .alert-box__content {
    min-width: 0;
    line-height: 1.58;
  }

  .alert-box__title {
    margin: 0;
    font-size: 0.92rem;
    font-weight: 700;
    line-height: 1.3;
    color: color-mix(in srgb, var(--alert-accent) 72%, var(--alert-fg));
  }

  .alert-box__message {
    margin: 0;
    font-weight: 500;
  }

  .alert-box__title + .alert-box__message,
  .alert-box__title + .alert-box__body,
  .alert-box__message + .alert-box__body {
    margin-top: 0.44rem;
  }

  .alert-box__body > :first-child {
    margin-top: 0;
  }

  .alert-box__body > :last-child {
    margin-bottom: 0;
  }

  .alert-box__body :global(a) {
    color: inherit;
    text-decoration-thickness: 2px;
    text-underline-offset: 2px;
  }

  .alert-box--warning {
    --alert-accent: var(--color-warning-1, #d97706);
    --alert-soft: var(--color-warning-3, #fde68a);
    --alert-fg: #7c2d12;
  }

  .alert-box--warning .alert-box__icon::before {
    content: "!";
  }

  .alert-box--danger {
    --alert-accent: var(--color-danger-1, #dc2626);
    --alert-soft: var(--color-danger-3, #fca5a5);
    --alert-fg: #7f1d1d;
  }

  .alert-box--danger .alert-box__icon::before {
    content: "x";
  }

  .alert-box--success {
    --alert-accent: var(--color-success-1, #16a34a);
    --alert-soft: var(--color-success-3, #86efac);
    --alert-fg: #14532d;
  }

  .alert-box--success .alert-box__icon::before {
    content: "v";
  }

  .alert-box--info {
    --alert-accent: var(--color-info-1, #0891b2);
    --alert-soft: var(--color-info-3, #cffafe);
    --alert-fg: #0f172a;
  }

  .alert-box--neutral {
    --alert-accent: var(--color-gray-1, #6b7280);
    --alert-soft: var(--color-gray-soft, #f3f4f6);
    --alert-fg: var(--text-1, #1f2937);
  }

  .alert-box--compact {
    gap: 0.68rem;
    padding: 0.72rem 0.86rem;
    border-radius: 12px;
  }

  .alert-box--outlined {
    background: color-mix(in srgb, var(--bg-elevated, #ffffff) 94%, transparent);
    box-shadow: none;
  }
</style>

<div
  class=("alert-box"
    + " alert-box--" + ((input.type || "info").toLowerCase())
    + (input.compact ? " alert-box--compact" : "")
    + (input.outlined ? " alert-box--outlined" : ""))
  role=(((input.type || "info").toLowerCase()) === "danger" ? "alert" : "status")
  aria-live=(((input.type || "info").toLowerCase()) === "danger" ? "assertive" : "polite")
>
  <div class=("alert-box__icon" + (input.icon ? " alert-box__icon--custom" : "")) aria-hidden="true">
    <if=input.icon>${input.icon}</if>
  </div>

  <div class="alert-box__content">
    <if=input.title>
      <p class="alert-box__title">${input.title}</p>
    </if>

    <if=input.message>
      <p class="alert-box__message">${input.message}</p>
    </if>

    <if=input.content>
      <div class="alert-box__body">
        <${input.content}/>
      </div>
    </if>
  </div>
</div>
