<style>
  .alert-box {
    padding: 1rem;
    border-radius: 4px;
    margin: 1rem 0;
  }
  .alert-box.warning {
    background: #fff3cd;
    border-left: 4px solid #ffc107;
    color: #856404;
  }
  .alert-box.info {
    background: #d1ecf1;
    border-left: 4px solid #17a2b8;
    color: #0c5460;
  }
  .alert-box.danger {
    background: #f8d7da;
    border-left: 4px solid #dc3545;
    color: #721c24;
  }
  .alert-box.success {
    background: #d4edda;
    border-left: 4px solid #28a745;
    color: #155724;
  }
</style>
<div class="alert-box ${input.type || 'info'}">
  <${input.content}/>
</div>
