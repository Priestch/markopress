/*!
 * Documentation Footer Component
 * Displays edit link, last updated timestamp, and prev/next navigation
 */

class {
  formatDate(date) {
    if (!date) return '';
    if (typeof window === 'undefined') return date;

    const d = new Date(date);
    return d.toLocaleDateString('en-US', {
      year: 'numeric',
      month: 'long',
      day: 'numeric'
    });
  }
}

<footer class="doc-footer">
  <!-- Edit Link -->
  <if=input.editUrl>
    <div class="doc-footer-edit">
      <a
        href=input.editUrl
        target="_blank"
        rel="noopener noreferrer"
        class="edit-link">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path>
          <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path>
        </svg>
        <span>Edit this page</span>
      </a>
    </div>
  </if>

  <!-- Last Updated -->
  <if=input.lastUpdated>
    <div class="doc-footer-updated">
      <span class="updated-label">Last updated:</span>
      <time datetime=input.lastUpdated>${formatDate(input.lastUpdated)}</time>
    </div>
  </if>

  <!-- Prev/Next Navigation -->
  <if=input.prev || input.next>
    <div class="doc-footer-nav">
      <!-- Previous Page -->
      <if=input.prev>
        <a class="page-nav-prev" href=input.prev.link>
          <span class="page-nav-label">Previous</span>
          <span class="page-nav-title">${input.prev.title}</span>
        </a>
      <else>
        <div class="page-nav-spacer"></div>
      </else>

      <!-- Next Page -->
      <if=input.next>
        <a class="page-nav-next" href=input.next.link>
          <span class="page-nav-label">Next</span>
          <span class="page-nav-title">${input.next.title}</span>
        </a>
      </if>
    </div>
  </if>
</footer>

<style>
  .doc-footer {
    margin-top: var(--space-3xl);
    padding-top: var(--space-xl);
    border-top: 1px solid var(--border-default);
  }

  /* Edit Link */
  .doc-footer-edit {
    margin-bottom: var(--space-md);
  }

  .edit-link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-xs);
    color: var(--text-2);
    font-size: var(--font-size-sm);
    text-decoration: none;
    transition: color var(--transition-fast);
  }

  .edit-link:hover {
    color: var(--color-primary-2, #3a5ccc);
  }

  .edit-link svg {
    flex-shrink: 0;
  }

  /* Last Updated */
  .doc-footer-updated {
    margin-bottom: var(--space-lg);
    font-size: var(--font-size-sm);
    color: var(--text-3);
  }

  .updated-label {
    margin-right: var(--space-xs);
  }

  /* Prev/Next Navigation */
  .doc-footer-nav {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-md);
    margin-top: var(--space-xl);
  }

  .page-nav-prev,
  .page-nav-next {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
    padding: var(--space-md);
    background: var(--bg-alt);
    border: 1px solid var(--border-default);
    border-radius: var(--radius-lg, 12px);
    text-decoration: none;
    color: var(--text-1);
    transition: all var(--transition-fast);
  }

  .page-nav-prev:hover,
  .page-nav-next:hover {
    border-color: var(--color-primary-2, #3a5ccc);
    background: var(--bg-soft);
  }

  .page-nav-prev {
    grid-column: 1;
    text-align: left;
  }

  .page-nav-next {
    grid-column: 2;
    text-align: right;
  }

  .page-nav-spacer {
    grid-column: 1;
  }

  .page-nav-label {
    font-size: var(--font-size-xs);
    font-weight: var(--font-weight-semibold);
    text-transform: uppercase;
    color: var(--text-2);
    letter-spacing: 0.05em;
  }

  .page-nav-title {
    font-size: var(--font-size-base);
    font-weight: var(--font-weight-medium);
  }

  /* Mobile Responsive */
  @media (max-width: 768px) {
    .doc-footer-nav {
      grid-template-columns: 1fr;
    }

    .page-nav-next {
      grid-column: 1;
    }

    .page-nav-spacer {
      display: none;
    }
  }
</style>
