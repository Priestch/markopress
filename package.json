{
  "name": "markopress",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @markopress/site dev",
    "build": "pnpm --filter @markopress/site build",
    "dev:vite": "pnpm --filter @markopress/site dev:vite",
    "build:vite": "pnpm --filter @markopress/site build:vite",
    "preview": "pnpm --filter @markopress/site preview",
    "preview:vite": "pnpm --filter @markopress/site preview:vite",
    "dev:perf": "pnpm --filter @markopress/site dev:perf",
    "build:perf": "pnpm --filter @markopress/site build:perf",
    "gen": "pnpm --filter @markopress/site gen",
    "test": "pnpm -r --filter './packages/*' test"
  }
}
